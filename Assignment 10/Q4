import re
import numpy as np
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.metrics.pairwise import cosine_similarity

# Write 2 short texts describing two different technologies
text_ai = "Artificial intelligence enables machines to learn from data, make decisions, and automate complex tasks like human reasoning."
text_bc = "Blockchain provides a decentralized, secure, and immutable ledger system for transparent digital asset transactions."

# 1. Preprocess and tokenize both texts
def simple_tokenize(text):
    return set(re.findall(r'\b[A-Za-z]+\b', text.lower()))

tokens_ai = simple_tokenize(text_ai)
tokens_bc = simple_tokenize(text_bc)

# 2. Calculate:
# a. Jaccard Similarity using sets
intersection = len(tokens_ai.intersection(tokens_bc))
union = len(tokens_ai.union(tokens_bc))
jaccard_sim = intersection / union if union != 0 else 0

# b. Cosine Similarity using TfidfVectorizer + cosine_similarity()
vectorizer = TfidfVectorizer()
tfidf_matrix = vectorizer.fit_transform([text_ai, text_bc])
cosine_sim = cosine_similarity(tfidf_matrix[0:1], tfidf_matrix[1:2])[0][0]

print(f"a. Jaccard Similarity: {jaccard_sim:.4f}")
print(f"b. Cosine Similarity: {cosine_sim:.4f}")

print("\nAnalysis:")
print("- Jaccard similarity measures the overlap of unique word sets, which is very low here because both texts discuss distinct technical domains.")
print("- Cosine similarity evaluates the vector angle of term frequencies, yielding a low score as well, confirming the semantic independence of AI and Blockchain descriptions.")
